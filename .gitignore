# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.idea
.claude/CLAUDE.md
.claude/settings.json
.claude/settings.local.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# lockfiles: bun.lock is the only one, CI and Vercel build with bun
package-lock.json
pnpm-lock.yaml
yarn.lock

# testing
/coverage

# generated runtime bundles: the .js are committed, the source maps are not
public/runtime/*.js.map

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/prisma/generated
